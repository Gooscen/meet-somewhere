<view class="page">
  <view class="eyebrow">聚会决定</view><view class="hero">{{meeting.selectedCandidateId ? '最终确认' : '确定地点'}}</view>
  <view wx:if="{{candidate}}" class="card accent-card"><view class="mini-label">SELECTED PLACE</view><view class="card-title">{{candidate.name}}</view><view>{{meeting.startsLabel}} · 人均 {{candidate.priceLabel}}</view><view class="muted">{{candidate.location.name}}</view></view>
  <view wx:if="{{meeting && !meeting.selectedCandidateId && isOrganizer && candidate}}" class="card"><text class="label">决定说明（可选）</text><textarea class="field textarea" value="{{note}}" bindinput="input" maxlength="240" placeholder="例如 回程更方便，预算也合适" /><button class="button" loading="{{saving}}" bindtap="finalize">确定地点</button><view class="sub">成员再次进入聚会时会看到决定，并可单独确认参加。</view></view>
  <view wx:if="{{meeting && meeting.selectedCandidateId}}" class="card"><view wx:if="{{meeting.decisionNote}}">组织者说明：{{meeting.decisionNote}}</view><view class="hint">地点意向不等于参加承诺。请单独确认是否参加。</view><view wx:if="{{meeting.status === 'closed'}}">本次聚会已结束。</view><view wx:else><view class="row-wrap"><view class="chip {{attendance === 'yes' ? 'active' : ''}}" data-value="yes" bindtap="confirm">参加</view><view class="chip {{attendance === 'no' ? 'active' : ''}}" data-value="no" bindtap="confirm">不参加</view><view class="chip {{attendance === 'maybe' ? 'active' : ''}}" data-value="maybe" bindtap="confirm">待定</view></view></view></view>
</view>
