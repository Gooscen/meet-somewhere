<view class="page" wx:if="{{candidate}}">
  <view class="eyebrow">候选餐厅</view><view class="hero">{{candidate.name}}</view>
  <view class="card accent-card"><view class="mini-label">PLACE DETAILS</view><view class="card-title">人均 {{candidate.priceLabel}}</view><view>{{candidate.cuisine || '菜系未提供'}}</view><view class="muted">{{candidate.location.name}} · {{candidate.location.address}}</view><view>{{candidate.note}}</view><view wx:if="{{candidate.sourceUrl}}" class="muted">来源：{{candidate.sourceUrl}}</view><view class="hint" wx:if="{{candidate.infoStatus !== 'verified'}}">{{candidate.infoStatus === 'pending' ? '信息待核实' : '信息未提供'}}</view><view class="divider"></view><view>{{candidate.routeLabel}}</view></view>
  <view class="card"><view class="mini-label">GROUP FEEDBACK</view><view class="card-title">大家的意向</view><view class="row-wrap"><text class="status-pill orange">很想去 {{candidate.distribution.love}}</text><text class="status-pill orange">比较想去 {{candidate.distribution.like}}</text><text class="status-pill">可以接受 {{candidate.distribution.okay}}</text></view><view>不太想去 {{candidate.distribution.dislike}} · 不方便 {{candidate.distribution.cannot}}</view><view class="muted">还没看过 {{candidate.distribution.unseen}} · 未评价 {{candidate.distribution.unrated}}</view></view>
  <view wx:if="{{meeting.status === 'collecting' && candidate.active}}" class="card">
    <view class="mini-label">YOUR RESPONSE</view><view class="card-title">你对这家店的想法？</view>
    <view class="row-wrap"><view class="chip {{rating === 'love' ? 'active' : ''}}" data-value="love" bindtap="select">很想去</view><view class="chip {{rating === 'like' ? 'active' : ''}}" data-value="like" bindtap="select">比较想去</view><view class="chip {{rating === 'okay' ? 'active' : ''}}" data-value="okay" bindtap="select">可以接受</view><view class="chip {{rating === 'dislike' ? 'active' : ''}}" data-value="dislike" bindtap="select">不太想去</view><view class="chip {{rating === 'cannot' ? 'active' : ''}}" data-value="cannot" bindtap="select">不方便参加</view><view class="chip {{rating === 'unseen' ? 'active' : ''}}" data-value="unseen" bindtap="select">还没看过</view></view>
    <view wx:if="{{rating === 'dislike' || rating === 'cannot'}}"><text class="label">原因类别（可选，仅作汇总）</text><view class="row-wrap"><view class="chip {{reason === 'budget' ? 'active' : ''}}" data-value="budget" bindtap="reason">预算</view><view class="chip {{reason === 'distance' ? 'active' : ''}}" data-value="distance" bindtap="reason">距离</view><view class="chip {{reason === 'time' ? 'active' : ''}}" data-value="time" bindtap="reason">时间</view><view class="chip {{reason === 'taste' ? 'active' : ''}}" data-value="taste" bindtap="reason">口味</view><view class="chip {{reason === 'other' ? 'active' : ''}}" data-value="other" bindtap="reason">其他</view></view></view>
    <button class="button" loading="{{saving}}" bindtap="save">提交评价</button>
    <view class="hint">地点意向只是协商意见，不代表最终参加承诺。</view>
  </view>
  <button wx:if="{{isOrganizer && meeting.status === 'collecting'}}" class="button light" bindtap="toggleActive">{{candidate.active ? '标记为不再考虑' : '恢复为候选'}}</button>
</view>
