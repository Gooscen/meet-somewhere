<view class="page">
  <view class="eyebrow">仅用于本次聚餐</view><view class="hero">我的情况</view><view class="sub">{{step + 1}} / 4 · 只需填写本次聚餐的信息</view><view class="progress-track"><view class="progress-fill" style="width: {{(step + 1) * 25}}%;"></view></view>
  <view wx:if="{{step === 0}}" class="card">
    <view class="card-title">时间与预算</view>
    <text class="label">我的称呼</text><input class="field" value="{{displayName}}" data-field="displayName" bindinput="input" maxlength="24" />
    <text class="label">这个时间能参加吗？</text>
    <view class="row-wrap"><view class="chip {{available === 'yes' ? 'active' : ''}}" data-field="available" data-value="yes" bindtap="select">可以</view><view class="chip {{available === 'no' ? 'active' : ''}}" data-field="available" data-value="no" bindtap="select">不可以</view><view class="chip {{available === 'unknown' ? 'active' : ''}}" data-field="available" data-value="unknown" bindtap="select">还不确定</view></view>
    <view wx:if="{{alternativeTime}}"><text class="label">其他候选时段：{{alternativeTime}}</text><view class="row-wrap"><view class="chip {{alternativeAvailability === 'yes' ? 'active' : ''}}" data-field="alternativeAvailability" data-value="yes" bindtap="select">可以</view><view class="chip {{alternativeAvailability === 'no' ? 'active' : ''}}" data-field="alternativeAvailability" data-value="no" bindtap="select">不可以</view><view class="chip {{alternativeAvailability === 'unknown' ? 'active' : ''}}" data-field="alternativeAvailability" data-value="unknown" bindtap="select">还不确定</view></view></view>
    <text class="label">其他方便时段（可选，组织者可见）</text><input class="field" placeholder="例如 周日 12:00–14:00" value="{{availableTimeNote}}" data-field="availableTimeNote" bindinput="input" maxlength="100" />
    <text class="label">最早可到（可选）</text><view class="row"><picker mode="date" value="{{earliestArrivalDate}}" data-field="earliestArrivalDate" bindchange="input"><view class="field">{{earliestArrivalDate || '选择日期'}}</view></picker><picker mode="time" value="{{earliestArrivalTime}}" data-field="earliestArrivalTime" bindchange="input"><view class="field">{{earliestArrivalTime}}</view></picker><text data-field="earliestArrivalDate" bindtap="clearDate">清除</text></view>
    <text class="label">必须离开（可选）</text><view class="row"><picker mode="date" value="{{mustLeaveAtDate}}" data-field="mustLeaveAtDate" bindchange="input"><view class="field">{{mustLeaveAtDate || '选择日期'}}</view></picker><picker mode="time" value="{{mustLeaveAtTime}}" data-field="mustLeaveAtTime" bindchange="input"><view class="field">{{mustLeaveAtTime}}</view></picker><text data-field="mustLeaveAtDate" bindtap="clearDate">清除</text></view>
    <text class="label">我的人均预算范围（可选）</text><view class="row"><input class="field" type="number" placeholder="最低" value="{{budgetMin}}" data-field="budgetMin" bindinput="input" /><text>至</text><input class="field" type="number" placeholder="最高" value="{{budgetMax}}" data-field="budgetMax" bindinput="input" /></view>
  </view>
  <view wx:elif="{{step === 1}}" class="card">
    <view class="card-title">去程</view><view class="sub">可搜索餐厅、地铁站或选择大致区域。位置只用于本次聚会。</view>
    <text class="label">从哪里出发？</text><view class="field">{{departure ? departure.name : '未填写，去程将显示未知'}}</view>
    <button class="button secondary" data-field="departure" bindtap="choose">搜索地点 / 地图选点</button><button wx:if="{{departure}}" class="button light" data-field="departure" bindtap="clearLocation">删除出发地</button>
    <text class="label">交通方式</text><view class="row-wrap"><view class="chip {{outboundMode === 'transit' ? 'active' : ''}}" data-field="outboundMode" data-value="transit" bindtap="select">公交/地铁</view><view class="chip {{outboundMode === 'driving' ? 'active' : ''}}" data-field="outboundMode" data-value="driving" bindtap="select">驾车</view><view class="chip {{outboundMode === 'walking' ? 'active' : ''}}" data-field="outboundMode" data-value="walking" bindtap="select">步行</view><view class="chip {{outboundMode === 'fastest' ? 'active' : ''}}" data-field="outboundMode" data-value="fastest" bindtap="select">较快路线</view></view>
    <text class="label">谁能看到出发地？</text><view class="row-wrap"><view class="chip {{departureVisibility === 'route_only' ? 'active' : ''}}" data-field="departureVisibility" data-value="route_only" bindtap="select">仅用于路线计算</view><view class="chip {{departureVisibility === 'organizer' ? 'active' : ''}}" data-field="departureVisibility" data-value="organizer" bindtap="select">仅组织者可见</view><view class="chip {{departureVisibility === 'members' ? 'active' : ''}}" data-field="departureVisibility" data-value="members" bindtap="select">本次成员可见</view></view>
  </view>
  <view wx:elif="{{step === 2}}" class="card">
    <view class="card-title">回程</view><view class="sub">散场后的目的地可以跳过；回程会单独显示未知。</view>
    <text class="label">散场后去哪里？</text><view class="field">{{returnTo ? returnTo.name : '未填写，回程将显示未知'}}</view>
    <button class="button secondary" data-field="returnTo" bindtap="choose">搜索地点 / 地图选点</button><button wx:if="{{returnTo}}" class="button light" data-field="returnTo" bindtap="clearLocation">删除散场后目的地</button>
    <text class="label">回程方式</text><view class="row-wrap"><view class="chip {{returnMode === 'transit' ? 'active' : ''}}" data-field="returnMode" data-value="transit" bindtap="select">公交/地铁</view><view class="chip {{returnMode === 'driving' ? 'active' : ''}}" data-field="returnMode" data-value="driving" bindtap="select">驾车</view><view class="chip {{returnMode === 'walking' ? 'active' : ''}}" data-field="returnMode" data-value="walking" bindtap="select">步行</view><view class="chip {{returnMode === 'fastest' ? 'active' : ''}}" data-field="returnMode" data-value="fastest" bindtap="select">较快路线</view></view>
    <text class="label">谁能看到散场后目的地？</text><view class="row-wrap"><view class="chip {{returnVisibility === 'route_only' ? 'active' : ''}}" data-field="returnVisibility" data-value="route_only" bindtap="select">仅用于路线计算</view><view class="chip {{returnVisibility === 'organizer' ? 'active' : ''}}" data-field="returnVisibility" data-value="organizer" bindtap="select">仅组织者可见</view><view class="chip {{returnVisibility === 'members' ? 'active' : ''}}" data-field="returnVisibility" data-value="members" bindtap="select">本次成员可见</view></view>
  </view>
  <view wx:else class="card">
    <view class="card-title">必须满足与一般偏好</view>
    <text class="label">最晚到达散场后目的地（可选，硬限制）</text><view class="row"><picker mode="date" value="{{maxReturnByDate}}" data-field="maxReturnByDate" bindchange="input"><view class="field">{{maxReturnByDate || '选择日期'}}</view></picker><picker mode="time" value="{{maxReturnByTime}}" data-field="maxReturnByTime" bindchange="input"><view class="field">{{maxReturnByTime}}</view></picker><text data-field="maxReturnByDate" bindtap="clearDate">清除</text></view>
    <text class="label">绝对不能超过的人均预算（可选，硬限制）</text><input class="field" type="number" placeholder="例如 200 元" value="{{hardBudgetMax}}" data-field="hardBudgetMax" bindinput="input" />
    <text class="label">其他必须满足的限制（仅你可见）</text><textarea class="field textarea" placeholder="例如 饮食或行动限制。系统会提示组织者需要确认，不展示具体内容。" value="{{hardRestriction}}" data-field="hardRestriction" bindinput="input" maxlength="240" />
    <text class="label">一般偏好（仅你可见）</text><textarea class="field textarea" placeholder="例如 安静、靠近地铁。不会当作硬限制。" value="{{preference}}" data-field="preference" bindinput="input" maxlength="240" />
    <view class="hint">隐私预览：出发地「{{departureVisibility === 'route_only' ? '仅用于路线计算' : departureVisibility === 'organizer' ? '仅组织者可见' : '本次成员可见'}}」；散场后目的地「{{returnVisibility === 'route_only' ? '仅用于路线计算' : returnVisibility === 'organizer' ? '仅组织者可见' : '本次成员可见'}}」。位置会提交给腾讯位置服务估算路线。组织者只看到限制冲突或待确认提示，看不到你填写的限制详情。你可以随时修改或删除位置。</view>
  </view>
  <view class="row"><button wx:if="{{step > 0}}" class="button light" bindtap="back">上一步</button><button wx:if="{{step < 3}}" class="button" bindtap="next">下一步</button><button wx:else class="button" loading="{{saving}}" bindtap="save">保存本次信息</button></view>
</view>
